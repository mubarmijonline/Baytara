<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only, and merged into debug builds only: lets the screenshot
         entrypoint (lib/demo_main.dart) play a demo clip served over plain HTTP from the
         host machine at 10.0.2.2. Release builds are unaffected. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>

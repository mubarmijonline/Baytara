<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest. It must match the App Privacy answers in App Store Connect
  (see APP_STORE_SUBMISSION.md section 7). Plugins and the Flutter engine ship their own
  manifests for the APIs they use; the app's own Swift (CaptureGuard) uses none of the
  "required reason" APIs, so NSPrivacyAccessedAPITypes is empty here.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>

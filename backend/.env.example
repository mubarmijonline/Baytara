# Flask — use random secrets >=32 bytes in prod, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
FLASK_ENV=development
SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-too

# PostgreSQL (source of truth — all finance)
DATABASE_URL=postgresql://baytara:baytara@localhost:5432/baytara

# MongoDB (non-financial high-volume logs) — used from Phase 5
MONGO_URL=mongodb://localhost:27017/baytara_logs

# Redis (sessions, rate-limit, idempotency) — used from Phase 4
REDIS_URL=redis://localhost:6379/0

# Public site origin and comma-separated origins allowed to call the API
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# InstaPay payments
# Google Vision service-account JSON (OCR). Path only — never commit the key; rotate if leaked.
GOOGLE_APPLICATION_CREDENTIALS=./graceful-castle-344401-d8a957ec77d0.json
# Where uploaded receipt images are stored
INSTAPAY_IMAGE_DIR=./instapay_image

# Admin-uploaded public images (instructor photos, course covers). Served at /api/v1/uploads/<file>.
UPLOAD_IMAGE_DIR=./uploads

# VdoCipher DRM (video). Server-side API secret only — never expose to the client.
VDOCIPHER_API_SECRET=
